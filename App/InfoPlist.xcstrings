{
  "sourceLanguage" : "zh-Hans",
  "strings" : {
    "CFBundleDisplayName" : {
      "comment" : "Bundle display name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "OpenFly Go"
          }
        }
      }
    },
    "CFBundleName" : {
      "comment" : "Bundle name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DJIVLNiOS"
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription" : {
      "comment" : "Privacy - Bluetooth Always Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Discover and connect to compatible DJI devices that use Bluetooth communication."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于发现并连接支持蓝牙通信的兼容 DJI 设备。"
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Access the iPhone camera only in a compatible feature the user explicitly chooses to capture images or video for a mission record. DJI live video does not access the iPhone camera."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于在用户主动选择的兼容功能中访问 iPhone 相机，采集任务记录所需的图像或视频；DJI 图传本身不会访问 iPhone 相机。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect to reconstruction services to view point clouds and download missions, and to UE or AirSim over a local network or personal hotspot."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于连接远程重建服务查看点云和下载航线，以及通过局域网或手机热点连接 UE/AirSim 仿真器。"
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location Always and When In Use Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Support location-related safety capabilities required for DJI SDK compatibility. OpenFly Go currently requests location only while using the app and does not initiate continuous background tracking."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于兼容 DJI SDK 的位置相关安全能力。OpenFly Go 当前仅在使用 App 时请求定位，不会自行在后台持续跟踪。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show the current device or remote-controller location on the map, help set the home point, and record location state for the current flight mission."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于在地图上显示当前设备或遥控器位置、辅助设置返航点和记录本次飞行任务的位置状态。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
