    },
    "当前遥控器或固件未提供 iOS 手机充电控制": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current remote controller or firmware does not provide iOS phone-charging control."
          }
        }
      }
    },
    "正在写入 DJI ChargeMobileMode，成功后将自动回读": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updating DJI ChargeMobileMode. The app will read it back after success."
          }
        }
      }
    },
    "自动读取暂时失败，仍可点击尝试开启": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic reading failed temporarily. You can still tap to try enabling it."
          }
        }
      }
    },
    "正在读取遥控器充电能力；失败时将于 1/2/4 秒重试": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading the remote controller charging capability. Failures retry after 1, 2, and 4 seconds."
          }
