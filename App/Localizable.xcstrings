      }
    },
    "最多保留 %@ 个版本": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep up to %@ versions"
          }
        }
      }
    },
    "删除后无法恢复，当前已载入的航线不会被清空。": {
