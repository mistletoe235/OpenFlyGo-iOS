          }
        }
      }
    },
    "任务库是本机 App 内的历史记录；导出 JSON 才会保存到“文件”App，可用于分享或换设备导入。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The task library stores history inside this app. Export JSON to save it in Files for sharing or importing on another device."
          }
        }
